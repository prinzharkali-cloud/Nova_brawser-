# Сервер
PORT=3000
NODE_ENV=production

# Ключ Serper (поиск)
SERPER_KEY=вставь_сюда

# URL твоего сервиса chatclaud
CHATCLAUD_URL=https://chatclaud.onrender.com

# Токен для защиты API (любая строка, потом будешь передавать)
API_TOKEN=смени_на_случайный

# Разрешить CORS для твоего домена
ALLOW_ORIGIN=*
